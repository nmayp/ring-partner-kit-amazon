#!/usr/bin/env python3
"""Stand-in for FFmpeg in tests. FAKE_FFMPEG_MODE: "ok" writes a JPEG to stdout; "401" fails like a rejected
token; anything else fails like an unreachable host. Arguments are appended to FAKE_FFMPEG_LOG if set."""
import os, sys

if os.environ.get("FAKE_FFMPEG_LOG"):
    with open(os.environ["FAKE_FFMPEG_LOG"], "a") as log:
        log.write("\t".join(sys.argv[1:]) + "\n")
mode = os.environ.get("FAKE_FFMPEG_MODE", "fail")
url = sys.argv[sys.argv.index("-i") + 1]
if mode == "ok":
    sys.stdout.buffer.write(b"\xff\xd8LIVE-FRAME\xff\xd9")
    sys.exit(0)
if mode == "401":
    sys.stderr.write(f"[rtsp @ 0x1] method DESCRIBE failed: 401 Unauthorized\n{url}: Server returned 401 Unauthorized\n")
    sys.exit(1)
sys.stderr.write(f"{url}: Connection refused\n")
sys.exit(1)
